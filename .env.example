# Google Gemini API Key for Gemini Flash (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# VietQR Payment Configuration (Optional, default MBBank)
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME=MBBank - Ngân hàng Quân Đội
VIETQR_ACCOUNT_NO=0988668899
VIETQR_ACCOUNT_NAME=AI ROAST CV TEAM

# SePay Webhook Secret Key (Optional)
SEPAY_WEBHOOK_KEY=your_sepay_webhook_key_here

# Zero-PII Rate Limiting Salts (Optional)
RATE_LIMIT_SALT=your_random_salt_here
TEASER_RATE_LIMIT_SALT=your_random_teaser_salt_here
